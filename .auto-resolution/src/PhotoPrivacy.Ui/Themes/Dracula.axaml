<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Color x:Key="SemiBackground0Color">#282A36</Color>
  <Color x:Key="SemiBackground1Color">#2E303E</Color>
  <Color x:Key="SemiBackground2Color">#44475A</Color>

  <SolidColorBrush x:Key="SemiColorBackground0" Color="{StaticResource SemiBackground0Color}" />
  <SolidColorBrush x:Key="SemiColorBackground1" Color="{StaticResource SemiBackground1Color}" />
  <SolidColorBrush x:Key="SemiColorBackground2" Color="{StaticResource SemiBackground2Color}" />
  <SolidColorBrush x:Key="SemiColorNavBackground" Color="{StaticResource SemiBackground1Color}" />

  <SolidColorBrush x:Key="SemiColorText0" Color="#F8F8F2" />
  <SolidColorBrush x:Key="SemiColorText1" Color="#E9E9F3" Opacity="0.8" />
  <SolidColorBrush x:Key="SemiColorText2" Color="#6272A4" Opacity="0.62" />

  <SolidColorBrush x:Key="SemiColorPrimary" Color="#BD93F9" />
  <SolidColorBrush x:Key="SemiColorPrimaryPointerover" Color="#BD93F9" Opacity="0.85" />
  <SolidColorBrush x:Key="SemiColorPrimaryLight" Color="#BD93F9" Opacity="0.15" />

  <SolidColorBrush x:Key="SemiColorBorder" Color="#44475A" Opacity="0.3" />

</ResourceDictionary>
