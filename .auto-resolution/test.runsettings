<?xml version="1.0" encoding="utf-8"?>
<RunSettings>
  <RunConfiguration>
    <!-- MaxCpuCount=1: single-slot serial (WORKFLOW S7 lesson) -->
    <MaxCpuCount>1</MaxCpuCount>
    <ResultsDirectory>.\TestResults</ResultsDirectory>
    <!-- Session hang backstop. Note: vstest runsettings has no LongRunningTestSeconds key; per-test threshold = xunit.runner.json longRunningTestSeconds -->
    <TestSessionTimeout>3600000</TestSessionTimeout>
  </RunConfiguration>
  <LoggerRunSettings>
    <Loggers>
      <Logger friendlyName="console" enabled="True" />
      <Logger friendlyName="blame" enabled="True" />
    </Loggers>
  </LoggerRunSettings>
</RunSettings>
