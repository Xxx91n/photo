<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Color x:Key="SemiBackground0Color">#282C34</Color>
  <Color x:Key="SemiBackground1Color">#21252B</Color>
  <Color x:Key="SemiBackground2Color">#2C313C</Color>

  <SolidColorBrush x:Key="SemiColorBackground0" Color="{StaticResource SemiBackground0Color}" />
  <SolidColorBrush x:Key="SemiColorBackground1" Color="{StaticResource SemiBackground1Color}" />
  <SolidColorBrush x:Key="SemiColorBackground2" Color="{StaticResource SemiBackground2Color}" />
  <SolidColorBrush x:Key="SemiColorNavBackground" Color="{StaticResource SemiBackground1Color}" />

  <SolidColorBrush x:Key="SemiColorText0" Color="#ABB2BF" />
  <SolidColorBrush x:Key="SemiColorText1" Color="#9DA5B4" Opacity="0.8" />
  <SolidColorBrush x:Key="SemiColorText2" Color="#5C6370" Opacity="0.62" />

  <SolidColorBrush x:Key="SemiColorPrimary" Color="#61AFEF" />
  <SolidColorBrush x:Key="SemiColorPrimaryPointerover" Color="#61AFEF" Opacity="0.85" />
  <SolidColorBrush x:Key="SemiColorPrimaryLight" Color="#61AFEF" Opacity="0.15" />

  <SolidColorBrush x:Key="SemiColorBorder" Color="#3E4451" Opacity="0.3" />

</ResourceDictionary>
