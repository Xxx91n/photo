<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ex="using:PhotoPrivacy.Ui.Localization" xmlns:vm="using:PhotoPrivacy.Ui.ViewModels" xmlns:audit="using:PhotoPrivacy.Ui" x:Class="PhotoPrivacy.Ui.Views.Pages.LogsPage" x:DataType="vm:MainWindowViewModel">
  <!-- 票 24（ADR 0061）：自 MainWindow.axaml 拆出的日志页（AuditTailService 日志流绑定保持不变）。 -->
  <Grid RowDefinitions="Auto,*">
    <Border Padding="24,20,24,16" BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="0,0,0,1">
      <TextBlock Text="{ex:Localize nav.logs}" Classes="title"/>
    </Border>

    <DockPanel Grid.Row="1" Margin="24,12,24,20">
      <Border DockPanel.Dock="Top"
              Padding="16,8"
              Background="{DynamicResource SemiColorNavBackground}"
              BorderBrush="{DynamicResource SemiColorBorder}"
              BorderThickness="0,1,0,1">
        <DockPanel>
          <Button DockPanel.Dock="Right" x:Name="ClearLogsButton" Content="{ex:Localize log.btn.clear}" Classes="ghost"/>
        </DockPanel>
      </Border>

      <ListBox x:Name="LogsList"
               ItemsSource="{Binding LogEntries}"
               Background="{DynamicResource SemiColorBackground0}"
               BorderThickness="0"
               Padding="4"
               ><!-- ADR 0051 A1: BaselinePixelAlignment deferred — TextOptions static setters need code-behind in Avalonia 12.1.1 (no XxxProperty field exposed; TigerMajor on 12.2+ road). FontFeatures tabular numbers below is the fully XAML-compatible survivor. -->
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="audit:AuditLogEntry">
            <Grid ColumnDefinitions="68,108,*,1.6*" Height="32" Background="Transparent">
              <TextBlock Text="{Binding TimeText}"
                         Classes="caption"
                         FontFeatures="+tnum"
                         VerticalAlignment="Center"/>
              <Border Grid.Column="1"
                      CornerRadius="4"
                      Padding="6,2"
                      Background="{DynamicResource SemiColorNavBackground}"
                      Margin="0,0,8,0"
                      VerticalAlignment="Center"
                      HorizontalAlignment="Left">
                <TextBlock Text="{Binding DisplayEvent}" Classes="caption" Foreground="{Binding ColorHex}" FontWeight="Medium"/>
              </Border>
              <TextBlock Grid.Column="2"
                         Text="{Binding SourcePathMasked}"
                         Classes="caption"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource SemiColorText1}"
                         TextTrimming="CharacterEllipsis"/>
              <TextBlock Grid.Column="3"
                         Classes="mono"
                         Text="{Binding Message}"
                         VerticalAlignment="Center"
                         Foreground="{DynamicResource SemiColorText0}"
                         TextTrimming="CharacterEllipsis"/>
            </Grid>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
      <!-- 票 26（ADR 0062）: 空审计流占位 — HasNoLogs 由 VM 在 Append/Clear 收口处联动刷新 -->
      <TextBlock Text="{ex:Localize log.empty}"
                 Classes="caption"
                 HorizontalAlignment="Center"
                 VerticalAlignment="Center"
                 IsVisible="{Binding HasNoLogs}"/>
    </DockPanel>
  </Grid>
</UserControl>
