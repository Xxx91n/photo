{
  "schema_version": 1,
  "exiftool": {
    "path": "C:\\Program Files\\ExifTool\\exiftool.exe",
    "enable_windows_long_path": true,
    "enable_large_file_support": true,
    "dry_run": false,
    "extra_exiftool_args": [],
    "stay_open_pool_size": 1,
    "max_parallel_drain": 1
  },
  "watch": {
    "hot_folder": "",
    "include_subdirectories": true,
    "debounce_ms": 800,
    "internal_buffer_size": 65536,
    "auto_excluded_directories": [],
    "polling_interval_seconds": 0
  },
  "rules": {
    "allowed_extensions": [
      ".jpg", ".jpeg", ".jpe", ".jps", ".jph",
      ".tif", ".tiff", ".dng",
      ".cr2", ".cr3", ".arw", ".nef", ".orf", ".raf",
      ".rw2", ".pef", ".srw", ".sr2",
      ".heic", ".heif", ".hif", ".avif",
      ".png", ".apng",
      ".mov", ".mp4", ".m4v", ".qt", ".3gp", ".3g2",
      ".pdf",
      ".eps", ".ps", ".ai"
    ],
    "excluded_patterns": [
      "~$*",
      "*.tmp"
    ],
    "output_mode": "same_as_source",
    "output_directory": ""
  },
  "retry": {
    "max_attempts": 3,
    "backoff_seconds": [
      1,
      3,
      10
    ]
  },
  "backup": {
    "enabled": true,
    "directory": "",
    "suffix": ".bak",
    "max_size_mb": 5000,
    "retain_days": 30
  },
  "quarantine": {
    "enabled": true,
    "directory": ""
  },
  "audit": {
    "log_directory": "",
    "retain_days": 30,
    "diagnostic_mode": false,
    "log_level": "info"
  },
  "ui": {
    "hide_main_window_on_startup": false,
    "hide_tray_icon": false,
    "theme_variant": "system",
    "theme_id": "catppuccin",
    "sidebar_width": 200.0
  }
}
