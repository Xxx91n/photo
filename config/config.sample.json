{
  "schema_version": 1,
  "exiftool": {
    "path": "C:\\Program Files\\ExifTool\\exiftool.exe",
    "enable_windows_long_path": true,
    "enable_large_file_support": true,
    "dry_run": false,
    "extra_exiftool_args": [],
    "stay_open_pool_size": 1,
    "max_parallel_drain": 1
  },
  "watch": {
    "hot_folder": "",
    "include_subdirectories": true,
    "debounce_ms": 800,
    "internal_buffer_size": 65536,
    "auto_excluded_directories": [],
    "polling_interval_seconds": 0
  },
  "rules": {
    "allowed_extensions": [
      ".jpg", ".jpeg", ".jpe", ".jps", ".jph", ".jpf", ".j2k", ".jp2", ".jng",
      ".jxl", ".jpm", ".jph", ".jpx", ".jxr",
      ".cr2", ".cr3", ".crw", ".crm", ".arw", ".nef", ".nrw", ".orf", ".ori", ".pef",
      ".raf", ".raw", ".rw2", ".rwl", ".sr2", ".srw", ".mef", ".mos", ".erf",
      ".mrw", ".dcp", ".dng", ".fff", ".gpr", ".lrf", ".lrv", ".iiq",
      ".tif", ".tiff",
      ".png", ".apng", ".pbm", ".pgm", ".ppm",
      ".heic", ".heif", ".hif", ".avif",
      ".psd", ".psdt", ".psb", ".ps", ".ps2", ".ps3", ".eps", ".eps2",
      ".eps3", ".epsf", ".ai", ".ait", ".ind", ".indd", ".indt", ".insp",
      ".pdf",
      ".mp4", ".m4a", ".m4b", ".m4p", ".m4v", ".mov", ".qt", ".3g2",
      ".3gp", ".3gp2", ".3gpp", ".f4a", ".f4b", ".f4p", ".f4v", ".mqv",
      ".360", ".aax", ".arq", ".ciff", ".cs1", ".dr4", ".dvb", ".exif",
      ".exv", ".flif", ".gif", ".glv", ".hdp", ".icc", ".icm", ".mie", ".mng",
      ".mpo", ".nksc", ".thm", ".vrd", ".wdp", ".webp", ".x3f", ".xmp"
    ],
    "excluded_patterns": [
      "~$*",
      "*.tmp"
    ],
    "output_mode": "same_as_source",
    "output_directory": ""
  },
  "retry": {
    "max_attempts": 3,
    "backoff_seconds": [
      1,
      3,
      10
    ]
  },
  "backup": {
    "enabled": true,
    "directory": "",
    "suffix": ".bak",
    "max_size_mb": 5000,
    "retain_days": 30
  },
  "quarantine": {
    "enabled": true,
    "directory": ""
  },
  "audit": {
    "log_directory": "",
    "retain_days": 30,
    "diagnostic_mode": true,
    "log_level": "debug"
  },
  "ui": {
    "hide_main_window_on_startup": false,
    "hide_tray_icon": false,
    "theme_variant": "system"
  }
}
