<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource SemiColorBackground0}" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
  </Style>

  <!-- Button variant baseline (ADR 0050 A2) + Size Ladder (ticket 01).
       Single source of truth for button sizing: content buttons 32 high
       (Padding 12,6), nav/nav-action 40 (Padding 12,0), icon-only 32x32
       (Padding 0). Views must not override Height/Padding/MinWidth inline. -->
  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource SemiColorPrimary}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="Height" Value="32" />
  </Style>

  <Style Selector="Button.primary:pointerover">
    <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryPointerover}" />
  </Style>

  <Style Selector="Button.primary:disabled">
    <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryDisabled}" />
    <Setter Property="Opacity" Value="0.5" />
  </Style>

  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="Height" Value="32" />
  </Style>

  <Style Selector="Button.ghost:pointerover">
    <Setter Property="Background" Value="{DynamicResource SemiColorBackground1}" />
  </Style>

  <Style Selector="Button.danger">
    <Setter Property="Foreground" Value="{DynamicResource SemiColorDanger}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SemiColorDanger}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    <Setter Property="Padding" Value="12,6" />
    <Setter Property="Height" Value="32" />
  </Style>

  <!-- Icon-only button variant (ticket 01): fixed 32x32 square, no padding.
       Content supplies its own icon size; views use Classes="icon" with no
       inline MinWidth/Padding. -->
  <Style Selector="Button.icon">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    <Setter Property="Padding" Value="0" />
    <Setter Property="Height" Value="32" />
    <Setter Property="MinWidth" Value="32" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.icon:pointerover">
    <Setter Property="Background" Value="{DynamicResource SemiColorBackground1}" />
  </Style>

  <Style Selector="Button.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Height" Value="40" />
  </Style>

  <Style Selector="Button.nav:pointerover">
    <Setter Property="Background" Value="{DynamicResource SemiColorBackground1}" />
    <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
  </Style>

  <Style Selector="Button.nav.active">
    <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryLight}" />
    <Setter Property="Foreground" Value="{DynamicResource SemiColorPrimary}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SemiColorPrimary}" />
    <Setter Property="BorderThickness" Value="4,0,0,0" />
  </Style>

  <Style Selector="Button.nav-action">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
    <Setter Property="Padding" Value="12,0" />
    <Setter Property="Height" Value="40" />
  </Style>

  <Style Selector="Button.nav-action:pointerover">
    <Setter Property="Background" Value="{DynamicResource SemiColorBackground1}" />
    <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
  </Style>

  <!-- Self-drawn titlebar caption buttons (ADR 0050 A4). Square hit area,
       transparent chrome, hover lifts to Semi neutral fill — same spec the
       Fluent/WindowDrawnDecorations template uses for non-client buttons. -->
  <Style Selector="Button.caption-btn">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="0" />
    <Setter Property="Padding" Value="16,6" />
    <Setter Property="Height" Value="32" />
    <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
    <Setter Property="HorizontalContentAlignment" Value="Center" />
    <Setter Property="VerticalContentAlignment" Value="Center" />
  </Style>

  <Style Selector="Button.caption-btn:pointerover">
    <Setter Property="Background" Value="{DynamicResource SemiColorBackground1}" />
    <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
  </Style>

  <Style Selector="Button.caption-btn:pressed">
    <Setter Property="Background" Value="{DynamicResource SemiColorBackground2}" />
  </Style>

  <!-- Close button hover turns danger red (industry convention, matches Windows.11/Fluent. -->
  <Style Selector="Button.caption-btn.danger:pointerover">
    <Setter Property="Background" Value="{DynamicResource SemiColorDanger}" />
    <Setter Property="Foreground" Value="White" />
  </Style>

  <!-- ADR 0051 A4: caption button pressed state — deeper fill for tactile feedback -->
  <Style Selector="Button.caption-btn.danger:pressed">
    <Setter Property="Background" Value="{DynamicResource SemiColorDanger}" />
    <Setter Property="Opacity" Value="0.8" />
  </Style>

  <!-- ADR 0051 A4: Window inactive state — caption buttons fade to secondary text color -->
  <Style Selector="Window:inactive Button.caption-btn">
    <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
  </Style>

  <!-- ADR 0051 A1: focus-visible pseudoclass — keyboard focus ring, preserves a11y -->
  <Style Selector="Button:focus-visible">
    <Setter Property="BorderBrush" Value="{DynamicResource SemiColorPrimaryLight}" />
    <Setter Property="BorderThickness" Value="2" />
  </Style>

  <!-- ADR 0050 A4 — window-state pseudoclasses for self-drawn titlebar.
       :maximized — drop titlebar padding so content fills to screen edge
                     (no system frame to consume the gap under WindowDecorations=None).
       :fullscreen — hide the caption buttons; a fullscreen window has no chrome anyway. -->
  <Style Selector="Window:maximized Border.titlebar-host">
    <Setter Property="Padding" Value="0" />
  </Style>

  <Style Selector="Window:fullscreen Button.caption-btn">
    <Setter Property="IsVisible" Value="False" />
  </Style>

  <!-- Elevated card with shadow (ADR 0050 A1). Lift the card above the
       window background using Semi's elevation token. -->
  <Style Selector="Border.settings-card">
    <Setter Property="Background" Value="{DynamicResource SemiColorBackground1}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="BoxShadow" Value="{DynamicResource Elevation2}" />
<Setter Property="Padding" Value="16" /><!-- ponytail: literal Thickness, not DynamicResource Double; Avalonia ThicknessTypeConverter runs at compile, DynamicResource skips it -> InvalidCastException -->
  </Style>

  <Style Selector="Border.settings-row">
<Setter Property="Padding" Value="16" /><!-- ponytail: literal Thickness, not DynamicResource Double; Avalonia ThicknessTypeConverter runs at compile, DynamicResource skips it -> InvalidCastException -->
  </Style>

  <Style Selector="Border.row-divider">
    <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>

  <!-- Typography 6-role system (ADR 0050 A1). Each class consumes its own FontSize token. -->
  <Style Selector="TextBlock.display">
    <Setter Property="FontSize" Value="{DynamicResource DisplayFontSize}" />
    <Setter Property="FontWeight" Value="Bold" />
    <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
  </Style>

  <Style Selector="TextBlock.headline">
    <Setter Property="FontSize" Value="{DynamicResource HeadlineFontSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
  </Style>

  <Style Selector="TextBlock.title">
    <Setter Property="FontSize" Value="{DynamicResource TitleFontSize}" />
    <Setter Property="FontWeight" Value="SemiBold" />
    <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
  </Style>

  <Style Selector="TextBlock.body">
    <Setter Property="FontSize" Value="{DynamicResource BodyFontSize}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
  </Style>

  <Style Selector="TextBlock.caption">
    <Setter Property="FontSize" Value="{DynamicResource CaptionFontSize}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
  </Style>

  <Style Selector="TextBlock.mono">
    <Setter Property="FontFamily" Value="{DynamicResource MonoFontFamily}" />
    <Setter Property="FontSize" Value="{DynamicResource MonoFontSize}" />
    <Setter Property="FontWeight" Value="Normal" />
    <Setter Property="Foreground" Value="{DynamicResource SemiColorText1}" />
  </Style>

  <Style Selector="TextBlock.section-header">
    <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.row-label">
    <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
  </Style>

  <Style Selector="TextBlock.row-desc">
    <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
  </Style>

  <Style Selector="TextBox.inline-input">
    <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    <!-- 票 24（ADR 0061）：Width=280 ×4/×5 收敛为共享 class 单一权威（Views 禁止内联宽度） -->
    <Setter Property="Width" Value="280" />
  </Style>

  <!-- 票 25：路径行收敛为 Ursa PathPicker 后 Width=280 单一权威随控件迁移（原 TextBox.inline-input 保留供排除目录等余量场景） -->
  <Style Selector="u|PathPicker.inline-input">
    <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
    <!-- 票 24（ADR 0061）：Width=280 ×4/×5 收敛为共享 class 单一权威（Views 禁止内联宽度） -->
    <Setter Property="Width" Value="280" />
  </Style>

  <!-- atomcode 2026-08-18: industry-standard button feedback = color transition only.
       Removed SukiUI pressed scale + RenderTransform transition (ADR 0051 A2).
       NN/g + Fluent 2: pressed = slight color change 100-150ms; scale is WCAG 2.2 SC 2.3.3 motion.
       Avalonia Fluent default uses 2% pressed scale but for enterprise privacy tool, pure color
       is the VS Code / Windows 11 Settings standard. :focus-visible already has border outline. -->
  <Style Selector="Button">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.150" Easing="SineEaseOut" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.150" Easing="SineEaseOut" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="ListBoxItem">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.150" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Border">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.150" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.150" />
      </Transitions>
    </Setter>
  </Style>
</Styles>
