<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Styles.Resources>
    <ResourceDictionary>
      <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light" />
        <ResourceDictionary x:Key="Dark" />
      </ResourceDictionary.ThemeDictionaries>
    <SolidColorBrush x:Key="AppBgBrush" Color="{DynamicResource SemiColorBackground0}" />
    <SolidColorBrush x:Key="SidebarBgBrush" Color="{DynamicResource SemiColorNavBackground}" />
    <SolidColorBrush x:Key="CardBgBrush" Color="{DynamicResource SemiColorBackground1}" />
    <SolidColorBrush x:Key="DividerBrush" Color="{DynamicResource SemiColorBorder}" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="{DynamicResource SemiColorText0}" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="{DynamicResource SemiColorText1}" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="{DynamicResource SemiColorText2}" />
    <SolidColorBrush x:Key="AccentRedBrush" Color="{DynamicResource SemiColorDanger}" />
    </ResourceDictionary>
  </Styles.Resources>

  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource SemiColorBackground0}" />
  </Style>

  <Style Selector="TextBlock">
    <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
  </Style>

  <Style Selector="Button.primary">
    <Setter Property="Background" Value="{DynamicResource SemiColorPrimary}" />
    <Setter Property="Foreground" Value="White" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
  </Style>

  <Style Selector="Button.primary:pointerover">
    <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryPointerover}" />
  </Style>

  <Style Selector="Button.primary:disabled">
    <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryDisabled}" />
    <Setter Property="Opacity" Value="0.5" />
  </Style>

  <Style Selector="Button.ghost">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
  </Style>

  <Style Selector="Button.ghost:pointerover">
    <Setter Property="Background" Value="{DynamicResource SemiColorBackground1}" />
  </Style>

  <Style Selector="Button.danger">
    <Setter Property="Foreground" Value="{DynamicResource SemiColorDanger}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SemiColorDanger}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
  </Style>

  <Style Selector="Button.nav">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
  </Style>

  <Style Selector="Button.nav:pointerover">
    <Setter Property="Background" Value="{DynamicResource SemiColorBackground1}" />
    <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
  </Style>

  <Style Selector="Button.nav.active">
    <Setter Property="Background" Value="{DynamicResource SemiColorPrimaryLight}" />
    <Setter Property="Foreground" Value="{DynamicResource SemiColorPrimary}" />
  </Style>

  <Style Selector="Button.nav-action">
    <Setter Property="Background" Value="Transparent" />
    <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
    <Setter Property="BorderThickness" Value="0" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
  </Style>

  <Style Selector="Button.nav-action:pointerover">
    <Setter Property="Background" Value="{DynamicResource SemiColorBackground1}" />
    <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
  </Style>

  <Style Selector="Border.settings-card">
    <Setter Property="Background" Value="{DynamicResource SemiColorBackground1}" />
    <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
    <Setter Property="BorderThickness" Value="1" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusMd}" />
    <Setter Property="Padding" Value="{DynamicResource SpaceLg}" />
  </Style>

  <Style Selector="Border.settings-row">
    <Setter Property="Padding" Value="{DynamicResource SpaceLg}" />
  </Style>

  <Style Selector="Border.row-divider">
    <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
    <Setter Property="BorderThickness" Value="0,0,0,1" />
  </Style>

  <Style Selector="TextBlock.section-header">
    <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
    <Setter Property="FontWeight" Value="SemiBold" />
  </Style>

  <Style Selector="TextBlock.row-label">
    <Setter Property="Foreground" Value="{DynamicResource SemiColorText0}" />
  </Style>

  <Style Selector="TextBlock.row-desc">
    <Setter Property="Foreground" Value="{DynamicResource SemiColorText2}" />
  </Style>

  <Style Selector="TextBox.inline-input">
    <Setter Property="BorderBrush" Value="{DynamicResource SemiColorBorder}" />
    <Setter Property="CornerRadius" Value="{DynamicResource RadiusSm}" />
  </Style>

  <Style Selector="Button">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.150" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="ListBoxItem">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.150" />
      </Transitions>
    </Setter>
  </Style>

  <Style Selector="Border">
    <Setter Property="Transitions">
      <Transitions>
        <BrushTransition Property="Background" Duration="0:0:0.150" />
        <BrushTransition Property="BorderBrush" Duration="0:0:0.150" />
      </Transitions>
    </Setter>
  </Style>
</Styles>
