<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Color x:Key="SemiBackground0Color">#2E3440</Color>
  <Color x:Key="SemiBackground1Color">#3B4252</Color>
  <Color x:Key="SemiBackground2Color">#434C5E</Color>

  <SolidColorBrush x:Key="SemiColorBackground0" Color="{StaticResource SemiBackground0Color}" />
  <SolidColorBrush x:Key="SemiColorBackground1" Color="{StaticResource SemiBackground1Color}" />
  <SolidColorBrush x:Key="SemiColorBackground2" Color="{StaticResource SemiBackground2Color}" />
  <!-- 票 02（ui-craft2 / D.1）：侧栏须比 Bg0 深一档；Nord Bg1 #3B4252 反浅于 Bg0 #2E3440，改深档惯例色 -->
  <SolidColorBrush x:Key="SemiColorNavBackground" Color="#242933" />

  <!-- 票 03（ui-craft2 / D-008）：nav 胶囊三态用刷 —— hover 中性半透明胶囊（Bg2@0.7 叠 navbg，MangoDisk sidebar-accent 档位等效），active 前景 on-primary 深字（Bg0，pastel 主色上白字不达 AA）。 -->
  <SolidColorBrush x:Key="SemiColorNavItemHover" Color="{StaticResource SemiBackground2Color}" Opacity="0.7" />
  <SolidColorBrush x:Key="SemiColorNavActiveForeground" Color="{StaticResource SemiBackground0Color}" />

  <SolidColorBrush x:Key="SemiColorText0" Color="#ECEFF4" />
  <SolidColorBrush x:Key="SemiColorText1" Color="#D8DEE9" Opacity="0.8" />
  <SolidColorBrush x:Key="SemiColorText2" Color="#81A1C1" Opacity="0.62" />

  <SolidColorBrush x:Key="SemiColorPrimary" Color="#88C0D0" />
  <SolidColorBrush x:Key="SemiColorPrimaryPointerover" Color="#88C0D0" Opacity="0.85" />
  <SolidColorBrush x:Key="SemiColorPrimaryLight" Color="#88C0D0" Opacity="0.15" />

  <SolidColorBrush x:Key="SemiColorBorder" Color="#4C566A" Opacity="0.3" />

</ResourceDictionary>
