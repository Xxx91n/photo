<ResourceDictionary xmlns="https://github.com/avaloniaui"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

  <Color x:Key="SemiBackground0Color">#1A1B26</Color>
  <Color x:Key="SemiBackground1Color">#16161E</Color>
  <Color x:Key="SemiBackground2Color">#24283B</Color>

  <SolidColorBrush x:Key="SemiColorBackground0" Color="{StaticResource SemiBackground0Color}" />
  <SolidColorBrush x:Key="SemiColorBackground1" Color="{StaticResource SemiBackground1Color}" />
  <SolidColorBrush x:Key="SemiColorBackground2" Color="{StaticResource SemiBackground2Color}" />
  <SolidColorBrush x:Key="SemiColorNavBackground" Color="{StaticResource SemiBackground1Color}" />

  <!-- 票 03（ui-craft2 / D-008）：nav 胶囊三态用刷 —— hover 中性半透明胶囊（Bg2@0.7 叠 navbg，MangoDisk sidebar-accent 档位等效），active 前景 on-primary 深字（Bg0，pastel 主色上白字不达 AA）。 -->
  <SolidColorBrush x:Key="SemiColorNavItemHover" Color="{StaticResource SemiBackground2Color}" Opacity="0.7" />
  <SolidColorBrush x:Key="SemiColorNavActiveForeground" Color="{StaticResource SemiBackground0Color}" />

  <SolidColorBrush x:Key="SemiColorText0" Color="#C0CAF5" />
  <SolidColorBrush x:Key="SemiColorText1" Color="#A9B1D6" Opacity="0.8" />
  <SolidColorBrush x:Key="SemiColorText2" Color="#565F89" Opacity="0.62" />

  <SolidColorBrush x:Key="SemiColorPrimary" Color="#7AA2F7" />
  <SolidColorBrush x:Key="SemiColorPrimaryPointerover" Color="#7AA2F7" Opacity="0.85" />
  <SolidColorBrush x:Key="SemiColorPrimaryLight" Color="#7AA2F7" Opacity="0.15" />

  <SolidColorBrush x:Key="SemiColorBorder" Color="#3B4261" Opacity="0.3" />

</ResourceDictionary>
