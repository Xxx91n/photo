<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="PhotoPrivacy.Ui.Views.MainWindow"
        Width="920"
        Height="600"
        MinWidth="740"
        MinHeight="480"
        Title="PhotoPrivacy"
        Background="{DynamicResource AppBgBrush}">
  <Grid ColumnDefinitions="200,*">
    <Border Grid.Column="0"
            Width="200"
            Background="{DynamicResource SidebarBgBrush}"
            BorderBrush="{DynamicResource DividerBrush}"
            BorderThickness="0,0,1,0">
      <DockPanel>
        <Border DockPanel.Dock="Top" Height="56" Padding="16,0">
          <StackPanel VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="PhotoPrivacy" FontSize="14" FontWeight="SemiBold"/>
            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
              <Ellipse Width="6" Height="6" Fill="{Binding ModeColor}"/>
              <TextBlock Text="{Binding ModeLabel}" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource DividerBrush}"/>

        <Border DockPanel.Dock="Top"
                Margin="10,10,10,0"
                Padding="12,10"
                Background="{DynamicResource AppBgBrush}"
                CornerRadius="8">
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Ellipse Width="8" Height="8" Fill="{Binding StatusDotColor}" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding RuntimeStatus}" FontSize="12" FontWeight="Medium" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="{Binding ExifToolVersion}" FontSize="11" Foreground="{DynamicResource TextTertiaryBrush}"/>
            <TextBlock Text="{Binding CurrentPage}" IsVisible="False"/>
          </StackPanel>
        </Border>

        <StackPanel DockPanel.Dock="Top" Margin="8,16,8,0" Spacing="2">
          <Button x:Name="ConfigNavButton" Classes="nav active" Content="配置" Tag="config"/>
          <Button x:Name="LogNavButton" Classes="nav" Content="日志" Tag="log"/>
          <Button x:Name="OpenServiceManagerTabButton"
                  Classes="nav"
                  Content="服务管理器"
                  Tag="service"
                  IsVisible="{Binding ShowServiceManagerTab}"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="8,0,8,12" Spacing="4">
          <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,0,0,4"/>
          <Button x:Name="PauseResumeButton"
                  Classes="nav-action"
                  Content="{Binding PauseResumeLabel}"
                  HorizontalAlignment="Stretch"/>
          <Button x:Name="OpenConfigDirButton"
                  Content="打开配置目录"
                  Classes="nav-action"
                  HorizontalAlignment="Stretch"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1" x:Name="MainContentGrid">
      <Grid x:Name="ConfigPage" RowDefinitions="Auto,*" IsVisible="True">
        <Border Padding="24,20,24,16" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
          <TextBlock Text="配置" FontSize="16" FontWeight="SemiBold"/>
        </Border>

        <ScrollViewer Grid.Row="1" Margin="24,16,24,20" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="0">
            <Border Classes="settings-card">
              <StackPanel>
                <TextBlock Text="路径设置" Classes="section-header"/>

                <Border Classes="settings-row">
                  <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="ExifTool 路径" Classes="row-label"/>
                      <TextBlock Text="exiftool 可执行文件的完整路径" Classes="row-desc"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Spacing="6">
                      <DockPanel LastChildFill="False" VerticalAlignment="Center">
                        <TextBox DockPanel.Dock="Left"
                                 Width="280"
                                 Text="{Binding ExifToolPath}"
                                 Classes="inline-input"
                                 VerticalAlignment="Center"/>
                        <Button x:Name="BrowseExifToolButton"
                                DockPanel.Dock="Right"
                                Content="…"
                                MinWidth="28"
                                Padding="4,0"
                                Classes="ghost"
                                VerticalAlignment="Center"/>
                      </DockPanel>
                      <TextBlock Text="{Binding ExifToolPathHint}"
                                 FontSize="11"
                                 Foreground="{DynamicResource TextTertiaryBrush}"
                                 IsVisible="{Binding HasExifToolHint}"/>
                    </StackPanel>
                  </DockPanel>
                </Border>

                <Border Classes="row-divider"/>

                <Border Classes="settings-row">
                  <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="监控目录" Classes="row-label"/>
                      <TextBlock Text="自动清理此目录下新增文件的元数据" Classes="row-desc"/>
                    </StackPanel>
                    <DockPanel DockPanel.Dock="Right" LastChildFill="False" VerticalAlignment="Center">
                      <TextBox DockPanel.Dock="Left"
                               Width="280"
                               Text="{Binding HotFolderPath}"
                               Classes="inline-input"
                               VerticalAlignment="Center"/>
                      <Button x:Name="BrowseHotFolderButton"
                              DockPanel.Dock="Right"
                              Content="…"
                              MinWidth="28"
                              Padding="4,0"
                              Classes="ghost"
                              VerticalAlignment="Center"/>
                    </DockPanel>
                  </DockPanel>
                </Border>
              </StackPanel>
            </Border>

            <Border Classes="settings-card">
              <StackPanel>
                <TextBlock Text="行为设置" Classes="section-header"/>

                <Border Classes="settings-row">
                  <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Spacing="2">
                      <TextBlock Text="启用备份" Classes="row-label"/>
                      <TextBlock Text="清理前将原文件复制到备份目录" Classes="row-desc"/>
                    </StackPanel>
                    <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding BackupEnabled}" VerticalAlignment="Center" OnContent="" OffContent=""/>
                  </DockPanel>
                </Border>

                <Border Classes="row-divider"/>

                <Border Classes="settings-row" IsVisible="{Binding BackupEnabled}">
                  <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Spacing="2">
                      <TextBlock Text="备份目录" Classes="row-label"/>
                      <TextBlock Text="留空默认使用监控目录/bak" Classes="row-desc"/>
                    </StackPanel>
                    <DockPanel DockPanel.Dock="Right" LastChildFill="False" VerticalAlignment="Center">
                      <TextBox DockPanel.Dock="Left"
                               Width="280"
                               Text="{Binding BackupDirectory}"
                               Classes="inline-input"
                               VerticalAlignment="Center"/>
                      <Button x:Name="BrowseBackupDirectoryButton"
                              DockPanel.Dock="Right"
                              Content="…"
                              MinWidth="28"
                              Padding="4,0"
                              Classes="ghost"
                              VerticalAlignment="Center"/>
                    </DockPanel>
                  </DockPanel>
                </Border>
<!-- 诊断日志已并入下方日志设置中的日志级别 -->

                <Border Classes="row-divider"/>

                <Border Classes="settings-row">
                  <DockPanel LastChildFill="False" VerticalAlignment="Center">
                    <StackPanel DockPanel.Dock="Left" Spacing="2">
                      <TextBlock Text="启用隔离目录" Classes="row-label"/>
                      <TextBlock Text="处理失败的文件移入此目录隔离" Classes="row-desc"/>
                    </StackPanel>
                    <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding QuarantineEnabled}" VerticalAlignment="Center" OnContent="" OffContent=""/>
                  </DockPanel>
                </Border>

                <Border Classes="row-divider"/>

                <Border Classes="settings-row" IsVisible="{Binding QuarantineEnabled}">
                  <DockPanel LastChildFill="False" VerticalAlignment="Center">
                    <StackPanel DockPanel.Dock="Left" Spacing="2">
                      <TextBlock Text="隔离目录" Classes="row-label"/>
                      <TextBlock Text="处理失败的文件存放路径" Classes="row-desc"/>
                    </StackPanel>
                    <DockPanel DockPanel.Dock="Right" LastChildFill="False" VerticalAlignment="Center">
                      <TextBox DockPanel.Dock="Left"
                               Width="280"
                               Text="{Binding QuarantineDirectory}"
                               Classes="inline-input"
                               VerticalAlignment="Center"/>
                      <Button x:Name="BrowseQuarantineDirectoryButton"
                              DockPanel.Dock="Right"
                              Content="…"
                              MinWidth="28"
                              Padding="4,0"
                              Classes="ghost"
                              VerticalAlignment="Center"/>
                    </DockPanel>
                  </DockPanel>
                </Border>

                <Border Classes="settings-row">
                  <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Spacing="2">
                      <TextBlock Text="启动时隐藏主窗口" Classes="row-label"/>
                      <TextBlock Text="启动后仅在托盘显示，不弹出主窗口" Classes="row-desc"/>
                    </StackPanel>
                    <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding HideGuiOnStartup}" VerticalAlignment="Center" OnContent="" OffContent=""/>
                  </DockPanel>
                </Border>

                <Border Classes="row-divider"/>

                <Border Classes="settings-row">
                  <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Spacing="2">
                      <TextBlock Text="隐藏托盘图标" Classes="row-label"/>
                      <TextBlock Text="在托盘模式下隐藏图标，仅保留后台处理" Classes="row-desc"/>
                    </StackPanel>
                    <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding HideTrayIcon}" VerticalAlignment="Center" OnContent="" OffContent=""/>
                  </DockPanel>
                </Border>

                <Border Classes="row-divider"/>

                <Border Classes="settings-row">
                  <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Spacing="2">
                      <TextBlock Text="界面主题" Classes="row-label"/>
                      <TextBlock Text="可在系统/亮色/暗色之间自由切换" Classes="row-desc"/>
                    </StackPanel>
                    <ComboBox x:Name="ThemeVariantComboBox"
                              DockPanel.Dock="Right"
                              Width="160">
                      <ComboBoxItem Content="跟随系统" Tag="system"/>
                      <ComboBoxItem Content="浅色"     Tag="light"/>
                      <ComboBoxItem Content="深色"     Tag="dark"/>
                    </ComboBox>
                  </DockPanel>
                </Border>
              </StackPanel>
            </Border>

            <Border Classes="settings-card">
              <StackPanel>
                <TextBlock Text="日志设置" Classes="section-header"/>

                <Border Classes="settings-row">
                  <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Spacing="2">
                      <TextBlock Text="日志级别" Classes="row-label"/>
                      <TextBlock Text="info=标准日志，debug=详细调试日志" Classes="row-desc"/>
                    </StackPanel>
                    <ComboBox x:Name="LogLevelComboBox"
                              DockPanel.Dock="Right"
                              Width="160">
                      <ComboBoxItem Content="ALL（全部）"   Tag="all"/>
                      <ComboBoxItem Content="INFO（标准）"  Tag="info"/>
                      <ComboBoxItem Content="DEBUG（调试）" Tag="debug"/>
                      <ComboBoxItem Content="WARN（警告）"  Tag="warn"/>
                      <ComboBoxItem Content="ERROR（错误）" Tag="error"/>
                    </ComboBox>
                  </DockPanel>
                </Border>

                <Border Classes="row-divider"/>

                <Border Classes="settings-row">
                  <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Spacing="2">
                      <TextBlock Text="日志保存路径" Classes="row-label"/>
                      <TextBlock Text="audit jsonl 文件的存放目录" Classes="row-desc"/>
                    </StackPanel>
                    <DockPanel DockPanel.Dock="Right" LastChildFill="False" VerticalAlignment="Center">
                      <TextBox DockPanel.Dock="Left"
                               Width="280"
                               Text="{Binding AuditLogDirectory}"
                               Classes="inline-input"
                               VerticalAlignment="Center"/>
                      <Button x:Name="BrowseAuditLogDirectoryButton"
                              DockPanel.Dock="Right"
                              Content="…"
                              MinWidth="28"
                              Padding="4,0"
                              Classes="ghost"
                              VerticalAlignment="Center"/>
                    </DockPanel>
                  </DockPanel>
                </Border>
              </StackPanel>
            </Border>

            <Border Classes="settings-card">
              <StackPanel>
                <TextBlock Text="排除监听列表" Classes="section-header"/>

                <Border Classes="settings-row">
                  <StackPanel Spacing="4">
                    <TextBlock Text="系统自动排除目录（只读）" Classes="row-label"/>
                    <TextBlock Text="日志、备份、隔离目录自动被排除在文件监听之外" Classes="row-desc"/>
                    <ListBox ItemsSource="{Binding SystemAutoExcludedDirectories}"
                             Height="80"
                             BorderBrush="{DynamicResource DividerBrush}"
                             BorderThickness="1"/>
                  </StackPanel>
                </Border>

                <Border Classes="row-divider"/>

                <Border Classes="settings-row">
                  <StackPanel Spacing="8">
                    <StackPanel Spacing="2">
                      <TextBlock Text="用户自定义排除目录" Classes="row-label"/>
                      <TextBlock Text="可添加额外路径以排除监听" Classes="row-desc"/>
                    </StackPanel>
                    <ListBox x:Name="UserExcludedDirectoriesListBox"
                             ItemsSource="{Binding UserExcludedDirectories}"
                             Height="80"
                             BorderBrush="{DynamicResource DividerBrush}"
                             BorderThickness="1"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Button x:Name="AddExcludedDirectoryButton" Content="+" Classes="ghost" MinWidth="28" Padding="4,0"/>
                      <Button x:Name="RemoveExcludedDirectoryButton" Content="-" Classes="ghost" MinWidth="28" Padding="4,0"/>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,8,0,0">
              <TextBlock Text="{Binding SaveStatus}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <Grid x:Name="LogPage" RowDefinitions="Auto,*" IsVisible="False">
        <Border Padding="24,20,24,16" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
          <TextBlock Text="日志" FontSize="16" FontWeight="SemiBold"/>
        </Border>

        <DockPanel Grid.Row="1" Margin="24,12,24,20">
          <Border DockPanel.Dock="Top"
                  Padding="16,8"
                  Background="{DynamicResource SidebarBgBrush}"
                  BorderBrush="{DynamicResource DividerBrush}"
                  BorderThickness="0,1,0,1">
            <DockPanel>
              <Button DockPanel.Dock="Right" x:Name="ClearLogsButton" Content="清空" Classes="ghost" Height="28" FontSize="12"/>
            </DockPanel>
          </Border>

          <ListBox x:Name="LogsList"
                   ItemsSource="{Binding LogEntries}"
                   Background="{DynamicResource AppBgBrush}"
                   BorderThickness="0"
                   Padding="4">
            <ListBox.ItemTemplate>
              <DataTemplate>
                <Grid ColumnDefinitions="68,108,*,1.6*" Height="32" Background="Transparent">
                  <TextBlock Text="{Binding TimeText}"
                             FontFamily="Cascadia Code,Consolas,monospace"
                             FontSize="11"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource TextTertiaryBrush}"/>
                  <Border Grid.Column="1"
                          CornerRadius="4"
                          Padding="6,2"
                          Background="{DynamicResource SidebarBgBrush}"
                          Margin="0,0,8,0"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Left">
                    <TextBlock Text="{Binding DisplayEvent}" FontSize="11" Foreground="{Binding ColorHex}" FontWeight="Medium"/>
                  </Border>
                  <TextBlock Grid.Column="2"
                             Text="{Binding SourcePathMasked}"
                             FontFamily="Cascadia Code,Consolas,monospace"
                             FontSize="11"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource TextSecondaryBrush}"
                             TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Column="3"
                             Text="{Binding Message}"
                             FontSize="12"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource TextPrimaryBrush}"
                             TextTrimming="CharacterEllipsis"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Grid>

      <Grid x:Name="ServiceManagerTab" RowDefinitions="Auto,*" IsVisible="False">
        <Border Padding="24,20,24,16" BorderBrush="{DynamicResource DividerBrush}" BorderThickness="0,0,0,1">
          <TextBlock Text="服务管理器" FontSize="16" FontWeight="SemiBold"/>
        </Border>

        <ScrollViewer Grid.Row="1" Margin="24,16,24,20" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Border Classes="settings-card">
              <StackPanel>
                <TextBlock Text="CURRENT STATUS" Classes="section-header" Margin="16,12,16,8"/>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0,16,12">
                  <Ellipse Width="10" Height="10" Fill="{Binding ServiceStatusDotColor}" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding ServiceStatus}" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Classes="settings-card">
              <StackPanel>
                <TextBlock Text="ACTIONS" Classes="section-header"/>

                <Border Classes="settings-row">
                  <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Spacing="2">
                      <TextBlock Text="安装并启动服务" Classes="row-label"/>
                      <TextBlock Text="将 PhotoPrivacyWorker 注册为 Windows 系统服务" Classes="row-desc"/>
                    </StackPanel>
                    <Button x:Name="InstallServiceButton" DockPanel.Dock="Right" Content="安装服务" Classes="primary" VerticalAlignment="Center"/>
                  </DockPanel>
                </Border>

                <Border Classes="row-divider"/>

                <Border Classes="settings-row">
                  <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Spacing="2">
                      <TextBlock Text="启动 / 停止服务" Classes="row-label"/>
                      <TextBlock Text="手动控制已安装服务的运行状态" Classes="row-desc"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                      <Button x:Name="StartServiceButton" Content="启动" Classes="ghost" VerticalAlignment="Center"/>
                      <Button x:Name="StopServiceButton" Content="停止" Classes="ghost" VerticalAlignment="Center"/>
                      <Button x:Name="RefreshServiceStatusButton" Content="刷新" Classes="ghost" VerticalAlignment="Center"/>
                    </StackPanel>
                  </DockPanel>
                </Border>

                <Border Classes="row-divider"/>

                <Border Classes="settings-row">
                  <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Spacing="2">
                      <TextBlock Text="卸载服务" Classes="row-label" Foreground="{DynamicResource AccentRedBrush}"/>
                      <TextBlock Text="从系统移除服务，切换为托盘模式运行" Classes="row-desc"/>
                    </StackPanel>
                    <Button x:Name="UninstallServiceButton" DockPanel.Dock="Right" Content="卸载服务" Classes="danger" VerticalAlignment="Center"/>
                  </DockPanel>
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</Window>
