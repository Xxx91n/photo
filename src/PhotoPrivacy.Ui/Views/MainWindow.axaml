<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ex="using:PhotoPrivacy.Ui.Localization"
        xmlns:vm="using:PhotoPrivacy.Ui.ViewModels"
        xmlns:audit="using:PhotoPrivacy.Ui"
         xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia"
        x:Class="PhotoPrivacy.Ui.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Width="920"
        Height="600"
        MinWidth="740"
        MinHeight="480"
        Title="PhotoPrivacy"
        FlowDirection="{Binding UiFlowDirection}"
        Background="{DynamicResource SemiColorBackground0}">
  <Grid ColumnDefinitions="200,*">
    <Border Grid.Column="0"
            Width="200"
            Background="{DynamicResource SemiColorNavBackground}"
            BorderBrush="{DynamicResource SemiColorBorder}"
            BorderThickness="0,0,1,0">
      <DockPanel>
        <Border DockPanel.Dock="Top" Height="56" Padding="16,0">
          <StackPanel VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="PhotoPrivacy" Classes="headline"/>
            <StackPanel Orientation="Horizontal" Spacing="5" VerticalAlignment="Center">
              <Ellipse Width="6" Height="6" Fill="{Binding ModeColor}"/>
              <TextBlock Text="{Binding ModeLabel}" FontSize="11" Foreground="{DynamicResource SemiColorText1}"/>
            </StackPanel>
          </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" Height="1" Background="{DynamicResource SemiColorBorder}"/>

        <Border DockPanel.Dock="Top"
                Margin="10,10,10,0"
                Padding="12,10"
                Background="{DynamicResource SemiColorBackground0}"
                CornerRadius="8">
          <StackPanel Spacing="8">
            <StackPanel Orientation="Horizontal" Spacing="6">
              <Ellipse Width="8" Height="8" Fill="{Binding StatusDotColor}" VerticalAlignment="Center"/>
              <TextBlock Text="{Binding RuntimeStatus}" Classes="caption" FontWeight="Medium" VerticalAlignment="Center"/>
            </StackPanel>
            <TextBlock Text="{Binding ExifToolVersion}" FontSize="11" Foreground="{DynamicResource SemiColorText2}"/>
            <TextBlock Text="{Binding CurrentPage}" IsVisible="False"/>
          </StackPanel>
        </Border>

        <StackPanel DockPanel.Dock="Top" Margin="8,16,8,0" Spacing="2">
          <Button x:Name="ConfigNavButton" Classes="nav active" Content="{ex:Localize nav.config}" Tag="config"/>
          <Button x:Name="LogNavButton" Classes="nav" Content="{ex:Localize nav.logs}" Tag="log"/>
          <Button x:Name="OpenServiceManagerTabButton"
                  Classes="nav"
                  Content="{ex:Localize nav.service_manager}"
                  Tag="service"
                  IsVisible="{Binding ShowServiceManagerTab}"/>
        </StackPanel>

        <StackPanel DockPanel.Dock="Bottom" Margin="8,0,8,12" Spacing="4">
          <Border Height="1" Background="{DynamicResource SemiColorBorder}" Margin="0,0,0,4"/>
          <Button x:Name="PauseResumeButton"
                  Classes="nav-action"
                  Content="{Binding PauseResumeLabel}"
                  HorizontalAlignment="Stretch"/>
          <Button x:Name="OpenConfigDirButton"
                  Content="{ex:Localize btn.open_config_dir}"
                  Classes="nav-action"
                  HorizontalAlignment="Stretch"/>
        </StackPanel>
      </DockPanel>
    </Border>

    <Grid Grid.Column="1" x:Name="MainContentGrid">
      <Grid x:Name="ConfigPage" RowDefinitions="Auto,*" IsVisible="True">
        <Border Padding="24,20,24,16" BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="0,0,0,1">
          <TextBlock Text="{ex:Localize nav.config}" Classes="title"/>
        </Border>

        <ScrollViewer Grid.Row="1" Margin="24,16,24,20" VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="0">
            <Border Classes="settings-card">
              <StackPanel>
                <TextBlock Text="{ex:Localize config.section.path}" Classes="section-header"/>

                <Border Classes="settings-row">
                  <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Spacing="2" VerticalAlignment="Center">
                      <StackPanel Orientation="Horizontal" Spacing="8"><materialIcons:MaterialIcon Kind="ImageMultiple" Width="16" Height="16" Foreground="{DynamicResource SemiColorPrimary}"/><TextBlock Text="{ex:Localize settings.exiftool_path}" Classes="row-label"/></StackPanel>
                      <TextBlock Text="{ex:Localize config.desc.exiftool_path}" Classes="row-desc"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Spacing="6">
                      <DockPanel LastChildFill="False" VerticalAlignment="Center">
                        <TextBox DockPanel.Dock="Left"
                                 Width="280"
                                 Text="{Binding ExifToolPath}"
                                 Classes="inline-input"
                                 VerticalAlignment="Center"/>
                        <Button x:Name="BrowseExifToolButton" DockPanel.Dock="Right" MinWidth="32" Padding="0" Classes="ghost" VerticalAlignment="Center"><materialIcons:MaterialIcon Kind="FolderOpen" Width="16" Height="16"/></Button>
                      </DockPanel>
                      <TextBlock Text="{Binding ExifToolPathHint}"
                                 FontSize="11"
                                 Foreground="{DynamicResource SemiColorText2}"
                                 IsVisible="{Binding HasExifToolHint}"/>
                    </StackPanel>
                  </DockPanel>
                </Border>

                <Border Classes="row-divider"/>

                <Border Classes="settings-row">
                  <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Spacing="2" VerticalAlignment="Center">
                      <TextBlock Text="{ex:Localize settings.hot_folder}" Classes="row-label"/>
                      <TextBlock Text="{ex:Localize config.desc.hot_folder}" Classes="row-desc"/>
                    </StackPanel>
                    <DockPanel DockPanel.Dock="Right" LastChildFill="False" VerticalAlignment="Center">
                      <TextBox DockPanel.Dock="Left"
                               Width="280"
                               Text="{Binding HotFolderPath}"
                               Classes="inline-input"
                               VerticalAlignment="Center"/>
                      <Button x:Name="BrowseHotFolderButton" DockPanel.Dock="Right" MinWidth="32" Padding="0" Classes="ghost" VerticalAlignment="Center"><materialIcons:MaterialIcon Kind="FolderOpen" Width="16" Height="16"/></Button>
                    </DockPanel>
                  </DockPanel>
                </Border>
              </StackPanel>
            </Border>

            <Border Classes="settings-card">
              <StackPanel>
                <TextBlock Text="{ex:Localize config.section.behavior}" Classes="section-header"/>

                <Border Classes="settings-row">
                  <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Spacing="2">
                      <TextBlock Text="{ex:Localize config.row.enable_backup}" Classes="row-label"/>
                      <TextBlock Text="{ex:Localize config.desc.backup_enabled}" Classes="row-desc"/>
                    </StackPanel>
                    <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding BackupEnabled}" VerticalAlignment="Center" OnContent="" OffContent=""/>
                  </DockPanel>
                </Border>

                <Border Classes="row-divider"/>

                <Border Classes="settings-row" IsVisible="{Binding BackupEnabled}">
                  <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Spacing="2">
                      <TextBlock Text="{ex:Localize settings.backup_dir}" Classes="row-label"/>
                      <TextBlock Text="{ex:Localize config.desc.backup_dir}" Classes="row-desc"/>
                    </StackPanel>
                    <DockPanel DockPanel.Dock="Right" LastChildFill="False" VerticalAlignment="Center">
                      <TextBox DockPanel.Dock="Left"
                               Width="280"
                               Text="{Binding BackupDirectory}"
                               Classes="inline-input"
                               VerticalAlignment="Center"/>
                      <Button x:Name="BrowseBackupDirectoryButton" DockPanel.Dock="Right" MinWidth="32" Padding="0" Classes="ghost" VerticalAlignment="Center"><materialIcons:MaterialIcon Kind="FolderOpen" Width="16" Height="16"/></Button>
                    </DockPanel>
                  </DockPanel>
                </Border>
<!-- 诊断日志已并入下方日志设置中的日志级别 -->

                <Border Classes="row-divider"/>

                <Border Classes="settings-row">
                  <DockPanel LastChildFill="False" VerticalAlignment="Center">
                    <StackPanel DockPanel.Dock="Left" Spacing="2">
                      <TextBlock Text="{ex:Localize config.row.enable_quarantine}" Classes="row-label"/>
                      <TextBlock Text="{ex:Localize config.desc.quarantine_enabled}" Classes="row-desc"/>
                    </StackPanel>
                    <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding QuarantineEnabled}" VerticalAlignment="Center" OnContent="" OffContent=""/>
                  </DockPanel>
                </Border>

                <Border Classes="row-divider"/>

                <Border Classes="settings-row" IsVisible="{Binding QuarantineEnabled}">
                  <DockPanel LastChildFill="False" VerticalAlignment="Center">
                    <StackPanel DockPanel.Dock="Left" Spacing="2">
                      <TextBlock Text="{ex:Localize settings.quarantine_dir}" Classes="row-label"/>
                      <TextBlock Text="{ex:Localize config.desc.quarantine_dir}" Classes="row-desc"/>
                    </StackPanel>
                    <DockPanel DockPanel.Dock="Right" LastChildFill="False" VerticalAlignment="Center">
                      <TextBox DockPanel.Dock="Left"
                               Width="280"
                               Text="{Binding QuarantineDirectory}"
                               Classes="inline-input"
                               VerticalAlignment="Center"/>
                      <Button x:Name="BrowseQuarantineDirectoryButton" DockPanel.Dock="Right" MinWidth="32" Padding="0" Classes="ghost" VerticalAlignment="Center"><materialIcons:MaterialIcon Kind="FolderOpen" Width="16" Height="16"/></Button>
                    </DockPanel>
                  </DockPanel>
                </Border>

                <Border Classes="settings-row">
                  <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Spacing="2">
                      <TextBlock Text="{ex:Localize settings.hide_on_startup}" Classes="row-label"/>
                      <TextBlock Text="{ex:Localize config.desc.hide_on_startup}" Classes="row-desc"/>
                    </StackPanel>
                    <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding HideGuiOnStartup}" VerticalAlignment="Center" OnContent="" OffContent=""/>
                  </DockPanel>
                </Border>

                <Border Classes="row-divider"/>

                <Border Classes="settings-row">
                  <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Spacing="2">
                      <TextBlock Text="{ex:Localize settings.hide_tray}" Classes="row-label"/>
                      <TextBlock Text="{ex:Localize config.desc.hide_tray}" Classes="row-desc"/>
                    </StackPanel>
                    <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding HideTrayIcon}" VerticalAlignment="Center" OnContent="" OffContent=""/>
                  </DockPanel>
                </Border>

                <Border Classes="row-divider"/>

                <Border Classes="settings-row">
                  <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Spacing="2">
                      <TextBlock Text="{ex:Localize settings.theme}" Classes="row-label"/>
                      <TextBlock Text="{ex:Localize config.desc.theme}" Classes="row-desc"/>
                    </StackPanel>
                    <ComboBox x:Name="ThemeVariantComboBox"
                              DockPanel.Dock="Right"
                              Width="160">
                      <ComboBoxItem Content="{ex:Localize theme.option.system}" Tag="system"/>
                      <ComboBoxItem Content="{ex:Localize theme.option.light}" Tag="light"/>
                      <ComboBoxItem Content="{ex:Localize theme.option.dark}" Tag="dark"/>
                    </ComboBox>
                  </DockPanel>
                </Border>

                <Border Classes="row-divider"/>

                <Border Classes="settings-row">
                  <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Spacing="2">
                      <TextBlock Text="{ex:Localize settings.language}" Classes="row-label"/>
                      <TextBlock Text="{ex:Localize config.desc.language}" Classes="row-desc"/>
                    </StackPanel>
                    <ComboBox x:Name="LocaleVariantComboBox"
                              DockPanel.Dock="Right"
                              Width="160"
                              SelectionChanged="OnLocaleSelectionChanged">
                      <ComboBoxItem Content="中文" Tag="zh-CN"/>
                      <ComboBoxItem Content="English" Tag="en"/>
                      <ComboBoxItem Content="日本語" Tag="ja"/>
                      <ComboBoxItem Content="한국어" Tag="ko"/>
                      <ComboBoxItem Content="Deutsch" Tag="de"/>
                      <ComboBoxItem Content="Français" Tag="fr"/>
                      <ComboBoxItem Content="Español" Tag="es"/>
                      <ComboBoxItem Content="Português" Tag="pt"/>
                      <ComboBoxItem Content="Русский" Tag="ru"/>
                      <ComboBoxItem Content="العربية" Tag="ar"/>
                    </ComboBox>
                  </DockPanel>
                </Border>
              </StackPanel>
            </Border>

            <Border Classes="settings-card">
              <StackPanel>
                <TextBlock Text="{ex:Localize config.section.logs}" Classes="section-header"/>

                <Border Classes="settings-row">
                  <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Spacing="2">
                      <TextBlock Text="{ex:Localize settings.log_level}" Classes="row-label"/>
                      <TextBlock Text="{ex:Localize config.desc.log_level}" Classes="row-desc"/>
                    </StackPanel>
                    <ComboBox x:Name="LogLevelComboBox"
                              DockPanel.Dock="Right"
                              Width="160">
                      <ComboBoxItem Content="{ex:Localize loglevel.option.all}" Tag="all"/>
                      <ComboBoxItem Content="{ex:Localize loglevel.option.info}" Tag="info"/>
                      <ComboBoxItem Content="{ex:Localize loglevel.option.debug}" Tag="debug"/>
                      <ComboBoxItem Content="{ex:Localize loglevel.option.warn}" Tag="warn"/>
                      <ComboBoxItem Content="{ex:Localize loglevel.option.error}" Tag="error"/>
                    </ComboBox>
                  </DockPanel>
                </Border>

                <Border Classes="row-divider"/>

                <Border Classes="settings-row">
                  <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Spacing="2">
                      <TextBlock Text="{ex:Localize settings.audit_log_dir_label}" Classes="row-label"/>
                      <TextBlock Text="{ex:Localize config.desc.audit_log_dir}" Classes="row-desc"/>
                    </StackPanel>
                    <DockPanel DockPanel.Dock="Right" LastChildFill="False" VerticalAlignment="Center">
                      <TextBox DockPanel.Dock="Left"
                               Width="280"
                               Text="{Binding AuditLogDirectory}"
                               Classes="inline-input"
                               VerticalAlignment="Center"/>
                      <Button x:Name="BrowseAuditLogDirectoryButton" DockPanel.Dock="Right" MinWidth="32" Padding="0" Classes="ghost" VerticalAlignment="Center"><materialIcons:MaterialIcon Kind="FolderOpen" Width="16" Height="16"/></Button>
                    </DockPanel>
                  </DockPanel>
                </Border>
              </StackPanel>
            </Border>

            <Border Classes="settings-card">
              <StackPanel>
                <TextBlock Text="{ex:Localize config.section.excluded}" Classes="section-header"/>

                <Border Classes="settings-row">
                  <StackPanel Spacing="4">
                    <TextBlock Text="{ex:Localize config.label.system_excluded}" Classes="row-label"/>
                    <TextBlock Text="{ex:Localize config.desc.system_excluded}" Classes="row-desc"/>
                    <ListBox ItemsSource="{Binding SystemAutoExcludedDirectories}"
                             Height="80"
                             BorderBrush="{DynamicResource SemiColorBorder}"
                             BorderThickness="1"/>
                  </StackPanel>
                </Border>

                <Border Classes="row-divider"/>

                <Border Classes="settings-row">
                  <StackPanel Spacing="8">
                    <StackPanel Spacing="2">
                      <TextBlock Text="{ex:Localize config.label.user_excluded}" Classes="row-label"/>
                      <TextBlock Text="{ex:Localize config.desc.user_excluded}" Classes="row-desc"/>
                    </StackPanel>
                    <ListBox x:Name="UserExcludedDirectoriesListBox"
                             ItemsSource="{Binding UserExcludedDirectories}"
                             Height="80"
                             BorderBrush="{DynamicResource SemiColorBorder}"
                             BorderThickness="1"/>
                    <StackPanel Orientation="Horizontal" Spacing="6">
                      <Button x:Name="AddExcludedDirectoryButton" Classes="ghost" MinWidth="32" Padding="0"><materialIcons:MaterialIcon Kind="Plus" Width="16" Height="16"/></Button>
                      <Button x:Name="RemoveExcludedDirectoryButton" Classes="ghost" MinWidth="32" Padding="0"><materialIcons:MaterialIcon Kind="Minus" Width="16" Height="16"/></Button>
                    </StackPanel>
                  </StackPanel>
                </Border>
              </StackPanel>
            </Border>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,8,0,0">
              <TextBlock Text="{Binding SaveStatus}" FontSize="12" Foreground="{DynamicResource SemiColorText1}" VerticalAlignment="Center"/>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <Grid x:Name="LogPage" RowDefinitions="Auto,*" IsVisible="False">
        <Border Padding="24,20,24,16" BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="0,0,0,1">
          <TextBlock Text="{ex:Localize nav.logs}" Classes="title"/>
        </Border>

        <DockPanel Grid.Row="1" Margin="24,12,24,20">
          <Border DockPanel.Dock="Top"
                  Padding="16,8"
                  Background="{DynamicResource SemiColorNavBackground}"
                  BorderBrush="{DynamicResource SemiColorBorder}"
                  BorderThickness="0,1,0,1">
            <DockPanel>
              <Button DockPanel.Dock="Right" x:Name="ClearLogsButton" Content="{ex:Localize log.btn.clear}" Classes="ghost"/>
            </DockPanel>
          </Border>

          <ListBox x:Name="LogsList"
                   ItemsSource="{Binding LogEntries}"
                   Background="{DynamicResource SemiColorBackground0}"
                   BorderThickness="0"
                   Padding="4">
            <ListBox.ItemTemplate>
              <DataTemplate x:DataType="audit:AuditLogEntry">
                <Grid ColumnDefinitions="68,108,*,1.6*" Height="32" Background="Transparent">
                  <TextBlock Text="{Binding TimeText}"
                             Classes="caption"
                             FontSize="11"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource SemiColorText2}"/>
                  <Border Grid.Column="1"
                          CornerRadius="4"
                          Padding="6,2"
                          Background="{DynamicResource SemiColorNavBackground}"
                          Margin="0,0,8,0"
                          VerticalAlignment="Center"
                          HorizontalAlignment="Left">
                    <TextBlock Text="{Binding DisplayEvent}" FontSize="11" Foreground="{Binding ColorHex}" FontWeight="Medium"/>
                  </Border>
                  <TextBlock Grid.Column="2"
                             Text="{Binding SourcePathMasked}"
                             Classes="caption"
                             FontSize="11"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource SemiColorText1}"
                             TextTrimming="CharacterEllipsis"/>
                  <TextBlock Grid.Column="3"
                             Text="{Binding Message}"
                             FontSize="12"
                             VerticalAlignment="Center"
                             Foreground="{DynamicResource SemiColorText0}"
                             TextTrimming="CharacterEllipsis"/>
                </Grid>
              </DataTemplate>
            </ListBox.ItemTemplate>
          </ListBox>
        </DockPanel>
      </Grid>

      <Grid x:Name="ServiceManagerTab" RowDefinitions="Auto,*" IsVisible="False">
        <Border Padding="24,20,24,16" BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="0,0,0,1">
          <TextBlock Text="{ex:Localize nav.service_manager}" Classes="title"/>
        </Border>

        <ScrollViewer Grid.Row="1" Margin="24,16,24,20" VerticalScrollBarVisibility="Auto">
          <StackPanel>
            <Border Classes="settings-card">
              <StackPanel>
                <TextBlock Text="{ex:Localize service.section.status}" Classes="section-header" Margin="16,12,16,8"/>
                <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="16,0,16,12">
                  <Ellipse Width="10" Height="10" Fill="{Binding ServiceStatusDotColor}" VerticalAlignment="Center"/>
                  <TextBlock Text="{Binding ServiceStatus}" Classes="headline" VerticalAlignment="Center"/>
                </StackPanel>
              </StackPanel>
            </Border>

            <Border Classes="settings-card">
              <StackPanel>
                <TextBlock Text="ACTIONS" Classes="section-header"/>

                <Border Classes="settings-row">
                  <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Spacing="2">
                      <TextBlock Text="{ex:Localize service.row.install_start}" Classes="row-label"/>
                      <TextBlock Text="{ex:Localize service.desc.install}" Classes="row-desc"/>
                    </StackPanel>
                    <Button x:Name="InstallServiceButton" DockPanel.Dock="Right" Content="{ex:Localize service.btn.install}" Classes="primary" VerticalAlignment="Center"/>
                  </DockPanel>
                </Border>

                <Border Classes="row-divider"/>

                <Border Classes="settings-row">
                  <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Spacing="2">
                      <TextBlock Text="{ex:Localize service.row.start_stop}" Classes="row-label"/>
                      <TextBlock Text="{ex:Localize service.desc.start_stop}" Classes="row-desc"/>
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="8">
                      <Button x:Name="StartServiceButton" Content="{ex:Localize service.btn.start}" Classes="ghost" VerticalAlignment="Center"/>
                      <Button x:Name="StopServiceButton" Content="{ex:Localize service.btn.stop}" Classes="ghost" VerticalAlignment="Center"/>
                      <Button x:Name="RefreshServiceStatusButton" Content="{ex:Localize service.btn.refresh}" Classes="ghost" VerticalAlignment="Center"/>
                    </StackPanel>
                  </DockPanel>
                </Border>

                <Border Classes="row-divider"/>

                <Border Classes="settings-row">
                  <DockPanel LastChildFill="False">
                    <StackPanel DockPanel.Dock="Left" Spacing="2">
                      <TextBlock Text="{ex:Localize service.row.uninstall}" Classes="row-label" Foreground="{DynamicResource SemiColorDanger}"/>
                      <TextBlock Text="{ex:Localize service.desc.uninstall}" Classes="row-desc"/>
                    </StackPanel>
                    <Button x:Name="UninstallServiceButton" DockPanel.Dock="Right" Content="{ex:Localize service.row.uninstall}" Classes="danger" VerticalAlignment="Center"/>
                  </DockPanel>
                </Border>
              </StackPanel>
            </Border>
          </StackPanel>
        </ScrollViewer>
      </Grid>
    </Grid>
  </Grid>
</Window>
