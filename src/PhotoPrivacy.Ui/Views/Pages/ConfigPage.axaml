<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ex="using:PhotoPrivacy.Ui.Localization" xmlns:vm="using:PhotoPrivacy.Ui.ViewModels" xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia" xmlns:behaviors="using:PhotoPrivacy.Ui.Behaviors" x:Class="PhotoPrivacy.Ui.Views.Pages.ConfigPage" x:DataType="vm:MainWindowViewModel">
  <!-- 票 24（ADR 0061）：自 MainWindow.axaml 拆出的配置页。路径输入宽度统一走 TextBox.inline-input 共享 class（Width=280 收敛为单一权威）。 -->
  <Grid RowDefinitions="Auto,*">
    <Border Padding="24,20,24,16" BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="0,0,0,1">
      <TextBlock Text="{ex:Localize nav.config}" Classes="title"/>
    </Border>
    <ScrollViewer Grid.Row="1" Margin="24,16,24,20" VerticalScrollBarVisibility="Auto" behaviors:MiddleClickScrollBehavior.IsEnabled="True">
      <StackPanel Spacing="0">
        <Border Classes="settings-card">
          <StackPanel>
            <TextBlock Text="{ex:Localize config.section.path}" Classes="section-header"/>
            <Border Classes="settings-row">
              <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Spacing="{DynamicResource SpaceXxs}" VerticalAlignment="Center">
                  <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpaceSm}"><materialIcons:MaterialIcon Kind="ImageMultiple" Width="16" Height="16" Foreground="{DynamicResource SemiColorPrimary}"/><TextBlock Text="{ex:Localize settings.exiftool_path}" Classes="row-label"/></StackPanel>
                  <TextBlock Text="{ex:Localize config.desc.exiftool_path}" Classes="row-desc"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Spacing="{DynamicResource SpaceSm}">
                  <DockPanel LastChildFill="False" VerticalAlignment="Center">
                    <TextBox DockPanel.Dock="Left" Text="{Binding ExifToolPath}" Classes="inline-input" VerticalAlignment="Center"/>
                    <Button x:Name="BrowseExifToolButton" DockPanel.Dock="Right" Classes="icon" VerticalAlignment="Center"><materialIcons:MaterialIcon Kind="FolderOpen" Width="16" Height="16"/></Button>
                  </DockPanel>
                  <TextBlock Text="{Binding ExifToolPathHint}" FontSize="11" Foreground="{DynamicResource SemiColorText2}" IsVisible="{Binding HasExifToolHint}"/>
                </StackPanel>
              </DockPanel>
            </Border>
            <Border Classes="row-divider"/>
            <Border Classes="settings-row">
              <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Spacing="{DynamicResource SpaceXxs}" VerticalAlignment="Center">
                  <TextBlock Text="{ex:Localize settings.hot_folder}" Classes="row-label"/>
                  <TextBlock Text="{ex:Localize config.desc.hot_folder}" Classes="row-desc"/>
                </StackPanel>
                <DockPanel DockPanel.Dock="Right" LastChildFill="False" VerticalAlignment="Center">
                  <TextBox DockPanel.Dock="Left" Text="{Binding HotFolderPath}" PlaceholderText="{Binding HotFolderPathHint}" Classes="inline-input" VerticalAlignment="Center"/>
                  <Button x:Name="BrowseHotFolderButton" DockPanel.Dock="Right" Classes="icon" VerticalAlignment="Center"><materialIcons:MaterialIcon Kind="FolderOpen" Width="16" Height="16"/></Button>
                </DockPanel>
              </DockPanel>
            </Border>
          </StackPanel>
        </Border>
        <Border Classes="settings-card">
          <StackPanel>
            <TextBlock Text="{ex:Localize config.section.behavior}" Classes="section-header"/>
            <Border Classes="settings-row">
              <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Spacing="{DynamicResource SpaceXxs}">
                  <TextBlock Text="{ex:Localize config.row.enable_backup}" Classes="row-label"/>
                  <TextBlock Text="{ex:Localize config.desc.backup_enabled}" Classes="row-desc"/>
                </StackPanel>
                <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding BackupEnabled}" VerticalAlignment="Center" OnContent="" OffContent=""/>
              </DockPanel>
            </Border>
            <Border Classes="row-divider"/>
            <Border Classes="settings-row" IsVisible="{Binding BackupEnabled}">
              <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Spacing="{DynamicResource SpaceXxs}">
                  <TextBlock Text="{ex:Localize settings.backup_dir}" Classes="row-label"/>
                  <TextBlock Text="{ex:Localize config.desc.backup_dir}" Classes="row-desc"/>
                </StackPanel>
                <DockPanel DockPanel.Dock="Right" LastChildFill="False" VerticalAlignment="Center">
                  <TextBox DockPanel.Dock="Left" Text="{Binding BackupDirectory}" PlaceholderText="{Binding BackupDirectoryHint}" Classes="inline-input" VerticalAlignment="Center"/>
                  <Button x:Name="BrowseBackupDirectoryButton" DockPanel.Dock="Right" Classes="icon" VerticalAlignment="Center"><materialIcons:MaterialIcon Kind="FolderOpen" Width="16" Height="16"/></Button>
                </DockPanel>
              </DockPanel>
            </Border>
            <Border Classes="row-divider"/>
            <Border Classes="settings-row">
              <DockPanel LastChildFill="False" VerticalAlignment="Center">
                <StackPanel DockPanel.Dock="Left" Spacing="{DynamicResource SpaceXxs}">
                  <TextBlock Text="{ex:Localize config.row.enable_quarantine}" Classes="row-label"/>
                  <TextBlock Text="{ex:Localize config.desc.quarantine_enabled}" Classes="row-desc"/>
                </StackPanel>
                <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding QuarantineEnabled}" VerticalAlignment="Center" OnContent="" OffContent=""/>
              </DockPanel>
            </Border>
            <Border Classes="row-divider"/>
            <Border Classes="settings-row" IsVisible="{Binding QuarantineEnabled}">
              <DockPanel LastChildFill="False" VerticalAlignment="Center">
                <StackPanel DockPanel.Dock="Left" Spacing="{DynamicResource SpaceXxs}">
                  <TextBlock Text="{ex:Localize settings.quarantine_dir}" Classes="row-label"/>
                  <TextBlock Text="{ex:Localize config.desc.quarantine_dir}" Classes="row-desc"/>
                </StackPanel>
                <DockPanel DockPanel.Dock="Right" LastChildFill="False" VerticalAlignment="Center">
                  <TextBox DockPanel.Dock="Left" Text="{Binding QuarantineDirectory}" PlaceholderText="{Binding QuarantineDirectoryHint}" Classes="inline-input" VerticalAlignment="Center"/>
                  <Button x:Name="BrowseQuarantineDirectoryButton" DockPanel.Dock="Right" Classes="icon" VerticalAlignment="Center"><materialIcons:MaterialIcon Kind="FolderOpen" Width="16" Height="16"/></Button>
                </DockPanel>
              </DockPanel>
            </Border>
            <Border Classes="settings-row">
              <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Spacing="{DynamicResource SpaceXxs}">
                  <TextBlock Text="{ex:Localize settings.hide_on_startup}" Classes="row-label"/>
                  <TextBlock Text="{ex:Localize config.desc.hide_on_startup}" Classes="row-desc"/>
                </StackPanel>
                <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding HideGuiOnStartup}" VerticalAlignment="Center" OnContent="" OffContent=""/>
              </DockPanel>
            </Border>
            <Border Classes="row-divider"/>
            <Border Classes="settings-row">
              <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Spacing="{DynamicResource SpaceXxs}">
                  <TextBlock Text="{ex:Localize settings.hide_tray}" Classes="row-label"/>
                  <TextBlock Text="{ex:Localize config.desc.hide_tray}" Classes="row-desc"/>
                </StackPanel>
                <ToggleSwitch DockPanel.Dock="Right" IsChecked="{Binding HideTrayIcon}" VerticalAlignment="Center" OnContent="" OffContent=""/>
              </DockPanel>
            </Border>
            <Border Classes="row-divider"/>
            <Border Classes="settings-row">
              <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Spacing="{DynamicResource SpaceXxs}">
                  <TextBlock Text="{ex:Localize settings.theme}" Classes="row-label"/>
                  <TextBlock Text="{ex:Localize config.desc.theme}" Classes="row-desc"/>
                </StackPanel>
                <ComboBox x:Name="ThemeVariantComboBox" DockPanel.Dock="Right" Width="160">
                  <ComboBoxItem Content="{ex:Localize theme.option.system}" Tag="system"/><ComboBoxItem Content="{ex:Localize theme.option.light}" Tag="light"/><ComboBoxItem Content="{ex:Localize theme.option.dark}" Tag="dark"/>
                </ComboBox>
              </DockPanel>
            </Border>
            <!-- ADR 0052 A3: Theme preset swatch grid — 5 community themes（票 24：Click 接线统一至 MainWindow） -->
            <Border Classes="settings-row">
              <StackPanel Spacing="{DynamicResource SpaceSm}">
                <TextBlock Text="{ex:Localize settings.theme_preset}" Classes="row-label"/>
                <WrapPanel ItemSpacing="{DynamicResource SpaceSm}">
                  <RadioButton x:Name="CatppuccinSwatch" Tag="catppuccin" GroupName="ThemePreset" Padding="8" CornerRadius="8"><StackPanel Orientation="Vertical" Spacing="4" HorizontalAlignment="Center"><Border Width="40" Height="28" CornerRadius="4" Background="#89B4FA"/><TextBlock Text="{ex:Localize preset.catppuccin}" Classes="caption" HorizontalAlignment="Center"/></StackPanel></RadioButton>
                  <RadioButton x:Name="DraculaSwatch" Tag="dracula" GroupName="ThemePreset" Padding="8" CornerRadius="8"><StackPanel Orientation="Vertical" Spacing="4" HorizontalAlignment="Center"><Border Width="40" Height="28" CornerRadius="4" Background="#BD93F9"/><TextBlock Text="{ex:Localize preset.dracula}" Classes="caption" HorizontalAlignment="Center"/></StackPanel></RadioButton>
                  <RadioButton x:Name="NordSwatch" Tag="nord" GroupName="ThemePreset" Padding="8" CornerRadius="8"><StackPanel Orientation="Vertical" Spacing="4" HorizontalAlignment="Center"><Border Width="40" Height="28" CornerRadius="4" Background="#88C0D0"/><TextBlock Text="{ex:Localize preset.nord}" Classes="caption" HorizontalAlignment="Center"/></StackPanel></RadioButton>
                  <RadioButton x:Name="OneDarkProSwatch" Tag="onedarkpro" GroupName="ThemePreset" Padding="8" CornerRadius="8"><StackPanel Orientation="Vertical" Spacing="4" HorizontalAlignment="Center"><Border Width="40" Height="28" CornerRadius="4" Background="#61AFEF"/><TextBlock Text="{ex:Localize preset.onedarkpro}" Classes="caption" HorizontalAlignment="Center"/></StackPanel></RadioButton>
                  <RadioButton x:Name="TokyoNightSwatch" Tag="tokyonight" GroupName="ThemePreset" Padding="8" CornerRadius="8"><StackPanel Orientation="Vertical" Spacing="4" HorizontalAlignment="Center"><Border Width="40" Height="28" CornerRadius="4" Background="#7AA2F7"/><TextBlock Text="{ex:Localize preset.tokyonight}" Classes="caption" HorizontalAlignment="Center"/></StackPanel></RadioButton>
                </WrapPanel>
              </StackPanel>
            </Border>
            <Border Classes="row-divider"/>
            <Border Classes="settings-row">
              <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Spacing="{DynamicResource SpaceXxs}">
                  <TextBlock Text="{ex:Localize settings.language}" Classes="row-label"/>
                  <TextBlock Text="{ex:Localize config.desc.language}" Classes="row-desc"/>
                </StackPanel>
                <ComboBox x:Name="LocaleVariantComboBox" DockPanel.Dock="Right" Width="160">
                  <ComboBoxItem Content="中文" Tag="zh-CN"/><ComboBoxItem Content="English" Tag="en"/><ComboBoxItem Content="日本語" Tag="ja"/><ComboBoxItem Content="한국어" Tag="ko"/><ComboBoxItem Content="Deutsch" Tag="de"/>
                  <ComboBoxItem Content="Français" Tag="fr"/><ComboBoxItem Content="Español" Tag="es"/><ComboBoxItem Content="Português" Tag="pt"/><ComboBoxItem Content="Русский" Tag="ru"/><ComboBoxItem Content="العربية" Tag="ar"/>
                </ComboBox>
              </DockPanel>
            </Border>
          </StackPanel>
        </Border>
        <Border Classes="settings-card">
          <StackPanel>
            <TextBlock Text="{ex:Localize config.section.logs}" Classes="section-header"/>
            <Border Classes="settings-row">
              <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Spacing="{DynamicResource SpaceXxs}">
                  <TextBlock Text="{ex:Localize settings.log_level}" Classes="row-label"/>
                  <TextBlock Text="{ex:Localize config.desc.log_level}" Classes="row-desc"/>
                </StackPanel>
                <ComboBox x:Name="LogLevelComboBox" DockPanel.Dock="Right" Width="160">
                  <ComboBoxItem Content="{ex:Localize loglevel.option.all}" Tag="all"/><ComboBoxItem Content="{ex:Localize loglevel.option.info}" Tag="info"/><ComboBoxItem Content="{ex:Localize loglevel.option.debug}" Tag="debug"/><ComboBoxItem Content="{ex:Localize loglevel.option.warn}" Tag="warn"/><ComboBoxItem Content="{ex:Localize loglevel.option.error}" Tag="error"/>
                </ComboBox>
              </DockPanel>
            </Border>
            <Border Classes="row-divider"/>
            <Border Classes="settings-row">
              <DockPanel LastChildFill="False">
                <StackPanel DockPanel.Dock="Left" Spacing="{DynamicResource SpaceXxs}">
                  <TextBlock Text="{ex:Localize settings.audit_log_dir_label}" Classes="row-label"/>
                  <TextBlock Text="{ex:Localize config.desc.audit_log_dir}" Classes="row-desc"/>
                </StackPanel>
                <DockPanel DockPanel.Dock="Right" LastChildFill="False" VerticalAlignment="Center">
                  <TextBox DockPanel.Dock="Left" Text="{Binding AuditLogDirectory}" Classes="inline-input" VerticalAlignment="Center"/>
                  <Button x:Name="BrowseAuditLogDirectoryButton" DockPanel.Dock="Right" Classes="icon" VerticalAlignment="Center"><materialIcons:MaterialIcon Kind="FolderOpen" Width="16" Height="16"/></Button>
                </DockPanel>
              </DockPanel>
            </Border>
          </StackPanel>
        </Border>
        <Border Classes="settings-card">
          <StackPanel>
            <TextBlock Text="{ex:Localize config.section.excluded}" Classes="section-header"/>
            <Border Classes="settings-row">
              <StackPanel Spacing="{DynamicResource SpaceXs}">
                <TextBlock Text="{ex:Localize config.label.system_excluded}" Classes="row-label"/>
                <TextBlock Text="{ex:Localize config.desc.system_excluded}" Classes="row-desc"/>
                <ListBox ItemsSource="{Binding SystemAutoExcludedDirectories}" Height="80" BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1"/>
              </StackPanel>
            </Border>
            <Border Classes="row-divider"/>
            <Border Classes="settings-row">
              <StackPanel Spacing="{DynamicResource SpaceSm}">
                <StackPanel Spacing="{DynamicResource SpaceXxs}">
                  <TextBlock Text="{ex:Localize config.label.user_excluded}" Classes="row-label"/>
                  <TextBlock Text="{ex:Localize config.desc.user_excluded}" Classes="row-desc"/>
                </StackPanel>
                <ListBox x:Name="UserExcludedDirectoriesListBox" ItemsSource="{Binding UserExcludedDirectories}" Height="80" BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="1"/>
                <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpaceSm}">
                  <Button x:Name="AddExcludedDirectoryButton" Classes="icon"><materialIcons:MaterialIcon Kind="Plus" Width="16" Height="16"/></Button>
                  <Button x:Name="RemoveExcludedDirectoryButton" Classes="icon"><materialIcons:MaterialIcon Kind="Minus" Width="16" Height="16"/></Button>
                </StackPanel>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="10" Margin="0,8,0,0">
          <TextBlock Text="{Binding SaveStatus}" FontSize="12" Foreground="{DynamicResource SemiColorText1}" VerticalAlignment="Center"/>
        </StackPanel>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
