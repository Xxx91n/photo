<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ex="using:PhotoPrivacy.Ui.Localization" xmlns:vm="using:PhotoPrivacy.Ui.ViewModels" xmlns:behaviors="using:PhotoPrivacy.Ui.Behaviors" xmlns:pages="using:PhotoPrivacy.Ui.Views.Pages" x:Class="PhotoPrivacy.Ui.Views.Pages.ConfigPage" x:DataType="vm:MainWindowViewModel">
  <!-- 票 24（ADR 0061）：自 MainWindow.axaml 拆出的配置页。
       票 04（ui-craft2 / D-005/D-006）：整页对齐 v2.0 —— 页壳（58 页头 + page-title + 右侧操作位）
       + 内容 readable 1160 居中 + 组标签出卡上方 + 行集合卡 settings-card.grouped。
       返工轮（2026-09-15）：4 分组抽为 Config*Group 子件消 Pages<=220 守卫红；
       本文件只保留页壳组合，视觉/行为零变化（控件访问器经 code-behind 转发）。 -->
  <Grid RowDefinitions="Auto,*">
    <Border MinHeight="{DynamicResource LayoutPageHeaderHeight}" Padding="24,0,24,0" BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="0,0,0,1">
      <DockPanel LastChildFill="False">
        <TextBlock Text="{ex:Localize nav.config}" Classes="page-title" VerticalAlignment="Center"/>
        <TextBlock Text="{Binding SaveStatus}" Classes="caption" Foreground="{DynamicResource SemiColorText1}" DockPanel.Dock="Right" VerticalAlignment="Center"/>
      </DockPanel>
    </Border>
    <ScrollViewer Grid.Row="1" Margin="24,16,24,24" VerticalScrollBarVisibility="Auto" behaviors:MiddleClickScrollBehavior.IsEnabled="True">
      <StackPanel Spacing="{DynamicResource SpaceXl}" MaxWidth="{DynamicResource LayoutContentWidthReadable}" HorizontalAlignment="Center">
        <pages:ConfigPathGroup/>
        <pages:ConfigBehaviorGroup x:Name="BehaviorGroup"/>
        <pages:ConfigLogsGroup x:Name="LogsGroup"/>
        <pages:ConfigExcludedGroup x:Name="ExcludedGroup"/>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
