<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:ex="using:PhotoPrivacy.Ui.Localization" xmlns:vm="using:PhotoPrivacy.Ui.ViewModels" xmlns:materialIcons="clr-namespace:Material.Icons.Avalonia;assembly=Material.Icons.Avalonia" x:Class="PhotoPrivacy.Ui.Views.Pages.RulesPage" x:DataType="vm:MainWindowViewModel">
  <!-- 票 24（ADR 0061）：自 MainWindow.axaml 拆出的规则页；h2 违例收敛为 title（report-22 B 节）。Save/Reset 接线统一至 MainWindow。 -->
  <Grid RowDefinitions="Auto,*">
    <Border Padding="24,24,24,16" BorderBrush="{DynamicResource SemiColorBorder}" BorderThickness="0,0,0,1">
      <StackPanel Spacing="{DynamicResource SpaceSm}">
        <TextBlock Text="{ex:Localize rules.panel.title}" Classes="title" />
        <TextBlock Text="{ex:Localize rules.panel.subtitle}" Classes="caption" Opacity="0.7" />
      </StackPanel>
    </Border>
    <ScrollViewer Grid.Row="1" Padding="24,16" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Spacing="{DynamicResource SpaceLg}">
        <Border Classes="settings-card">
          <StackPanel Spacing="{DynamicResource SpaceSm}">
            <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpaceMd}" VerticalAlignment="Center">
              <materialIcons:MaterialIcon Kind="ShieldAccountOutline" Width="20" Height="20"/>
              <TextBlock Text="{ex:Localize rules.expert.mode}" Classes="body" VerticalAlignment="Center"/>
              <ToggleSwitch x:Name="ExpertModeToggle" IsChecked="{Binding RulesPanel.IsExpertMode, Mode=TwoWay}" OnContent="" OffContent="" />
            </StackPanel>
            <Border x:Name="ExpertModeInfobar" Background="{DynamicResource SemiColorWarningBg}" CornerRadius="6" Padding="12,8" IsVisible="{Binding !RulesPanel.IsExpertMode}">
              <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpaceSm}">
                <materialIcons:MaterialIcon Kind="AlertOutline" Width="16" Height="16" Foreground="{DynamicResource SemiColorWarning}"/>
                <TextBlock Text="{ex:Localize rules.expert.infobar}" Classes="caption" VerticalAlignment="Center" TextWrapping="Wrap"/>
              </StackPanel>
            </Border>
          </StackPanel>
        </Border>
        <StackPanel Orientation="Horizontal" Spacing="{DynamicResource SpaceSm}" HorizontalAlignment="Stretch" Grid.IsSharedSizeScope="True">
          <TextBox x:Name="RulesSearchBox" Text="{Binding RulesPanel.SearchFilter, Mode=TwoWay}" PlaceholderText="{ex:Localize rules.search.placeholder}" MinWidth="260" />
          <!-- 票 03（ui-craft R1-1）：保存 / 重置同组等宽 —— Grid + SharedSizeGroup，组内最长文案定宽 -->
          <Grid ColumnSpacing="{DynamicResource SpaceSm}" VerticalAlignment="Center">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="Auto" SharedSizeGroup="RuleActions"/>
              <ColumnDefinition Width="Auto" SharedSizeGroup="RuleActions"/>
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" x:Name="SaveRulesButton" Classes="ghost" Content="{ex:Localize rules.btn.save}" HorizontalAlignment="Stretch"/>
            <Button Grid.Column="1" x:Name="ResetRulesButton" Classes="ghost" Content="{ex:Localize rules.btn.reset}" HorizontalAlignment="Stretch"/>
          </Grid>
          <TextBlock x:Name="RulesSaveStatus" Text="{Binding RulesPanel.SaveStatus}" Classes="caption" VerticalAlignment="Center" Margin="8,0,0,0" Opacity="0.6" />
        </StackPanel>
        <Grid MinHeight="280">
        <DataGrid x:Name="RulesDataGrid"
                  ItemsSource="{Binding RulesPanel.Rules}"
                  AutoGenerateColumns="False"
                  IsReadOnly="False"
                  GridLinesVisibility="All"
                  FrozenColumnCount="1"
                  SelectionMode="Single"
                  HeadersVisibility="Column"
                  CanUserSortColumns="True"
                  Classes="data-grid">
          <DataGrid.Columns>
            <DataGridTextColumn Header="{ex:Localize rules.col.family}" Binding="{Binding FamilyName}" Width="90" IsReadOnly="True"/>
            <DataGridTextColumn Header="{ex:Localize rules.col.extensions}" Binding="{Binding Extensions}" Width="140" IsReadOnly="True"/>
            <DataGridCheckBoxColumn Header="{ex:Localize rules.col.enabled}" Binding="{Binding IsEnabled}" Width="60"/>
            <DataGridCheckBoxColumn Header="{ex:Localize rules.col.strip_all}" Binding="{Binding StripAll}" Width="60"/>
            <DataGridCheckBoxColumn Header="{ex:Localize rules.col.preserve_icc}" Binding="{Binding PreserveIcc}" Width="70"/>
            <DataGridCheckBoxColumn Header="{ex:Localize rules.col.strip_exif}" Binding="{Binding StripExif}" Width="60"/>
            <DataGridCheckBoxColumn Header="{ex:Localize rules.col.strip_xmp}" Binding="{Binding StripXmp}" Width="60"/>
            <DataGridCheckBoxColumn Header="{ex:Localize rules.col.strip_iptc}" Binding="{Binding StripIptc}" Width="60"/>
            <DataGridCheckBoxColumn Header="{ex:Localize rules.col.strip_time}" Binding="{Binding StripTime}" Width="60"/>
            <DataGridTextColumn Header="{ex:Localize rules.col.warning}" Binding="{Binding WarningLevel}" Width="70" IsReadOnly="True"/>
            <DataGridTextColumn Header="{ex:Localize rules.col.effective_args}" Binding="{Binding EffectiveArgs}" Width="*" IsReadOnly="True"/>
          </DataGrid.Columns>
        </DataGrid>
          <!-- 票 26（ADR 0062）: 规则空态占位 — 筛选无命中 / 加载为空时可见 -->
          <TextBlock Text="{ex:Localize rules.empty}"
                     Classes="caption"
                     HorizontalAlignment="Center"
                     VerticalAlignment="Center"
                     IsVisible="{Binding RulesPanel.HasNoVisibleRules}"/>
        </Grid>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
