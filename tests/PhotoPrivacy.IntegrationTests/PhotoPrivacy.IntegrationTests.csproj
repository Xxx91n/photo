<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <!-- 与 PhotoPrivacy.Ipc 同口径：Windows 宿主才编译 PP_WINDOWS_HOST 分区的测试
         （WindowsPipeNative 等 Windows 编译面 API，CI test job 为 ubuntu，不覆盖）。 -->
    <DefineConstants Condition="'$(OS)' == 'Windows_NT'">$(DefineConstants);PP_WINDOWS_HOST</DefineConstants>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.4" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="xunit" Version="2.9.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="3.1.4" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\PhotoPrivacy.Core\PhotoPrivacy.Core.csproj" />
    <ProjectReference Include="..\..\src\PhotoPrivacy.Worker\PhotoPrivacy.Worker.csproj" />
    <ProjectReference Include="..\..\src\PhotoPrivacy.Ipc\PhotoPrivacy.Ipc.csproj" />
  </ItemGroup>

  <ItemGroup>
    <None Include="..\..\xunit.runner.json" Link="xunit.runner.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
